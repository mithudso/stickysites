# The browser extension has no dotenv loader. Export values in the launching shell;
# this file is documentation and is not loaded automatically. These are paths, not secrets.

# Optional Chrome for Testing/Chromium binary for BOTH verify:live and store:screenshots.
SS_CHROME='/path/to/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing'

# Optional peer daemon state directory (default: ~/.stickysites).
# Peer integration tests create and supply isolated temporary homes automatically.
STICKYSITES_HOME=/path/to/private/stickysites-test-home
